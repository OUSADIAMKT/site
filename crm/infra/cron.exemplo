# /etc/cron.d/ousadia-crm
# A coleta da Meta, as automações de tempo e a devolução de conversas rodam
# dentro do próprio CRM (fila de tarefas, api/_fila_tarefas.js). Aqui fica só
# o que precisa rodar fora dele: o backup.
SHELL=/bin/sh
TZ=America/Sao_Paulo

# Backup do banco todo dia às 3h (ver backup.sh). flock impede duas cópias
# rodando ao mesmo tempo se uma travar.
0 3 * * * root flock -n /tmp/backup-crm.lock sh /opt/ousadia-crm/atual/infra/backup.sh
