# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# velite (camada de conteudo gerada)
/.velite/
/public/static/

# typescript
*.tsbuildinfo
next-env.d.ts

# legado (materiais das versoes antigas do site - nao versionar)
/legado/

# worktree temporario usado pelo scripts/deploy.mjs
/.deploy-out/
